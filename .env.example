# 复制为 .env 后按需修改
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=vault

DB_PORT=5433
APP_PORT=8080

# 时区兜底（EXIF/GPS 都给不出偏移时用这个）
DEFAULT_TZ_OFFSET_MIN=480
TZ=Asia/Shanghai

# ⚠️ 关键设置：宿主机上「素材 + vault」的**共同父目录**。
#
#   必须只挂这一个目录。Docker 里每个 bind mount 是独立设备，
#   素材与 vault 分开挂载时硬链接会失败（EXDEV），只能退回拷贝。
#
#   家庭机示例（素材本来就散在 D 盘）：
#       HOST_ROOT=D:\photo
#   目录结构：
#       D:\photo\vault\     ← 本系统写入，内容寻址
#       D:\photo\derived\   ← 缩略图/代理，可删可重建
#       D:\photo\source\    ← 你现有的相册，原样不动
#
#   注意：HOST_ROOT 不要指向 SMB 网络盘（如 Z:\）——既不支持硬链接，挂载也不可靠。
HOST_ROOT=./host

# 影视库：宿主机上的电影 / 剧集目录，容器里挂成 /media。
#
# 和相册不同，影视**只登记路径、不搬文件、不算哈希、不跑 AI**：一部电影几十 GB，
# 硬链接又只能同卷，拷贝一份等于把硬盘复制一遍。所以影视可以放在另一块盘上，
# 不需要和 vault 同卷。
#
#   例：MEDIA_HOST_ROOT=E:\Movies
#   目录里可以混放电影和剧集：
#       E:\Movies\The.Matrix.1999.1080p.mkv
#       E:\Movies\Breaking Bad\Season 1\Breaking.Bad.S01E01.mkv
#       E:\Movies\Breaking Bad\Season 1\Breaking.Bad.S01E01.zh-CN.srt
#
# 不设时挂的是仓库里的 ./media（测试/空目录）；填了宿主机路径后，
# Web 的「影视 → 添加影视」和 CLI `cinema-import` 都按这个根来映射。
MEDIA_HOST_ROOT=./media
